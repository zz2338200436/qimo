@startuml
left to right direction
actor 学生
actor 教师
actor 管理员
rectangle "学生端" {
  usecase "课程学习" as S1
  usecase "作业提交" as S2
  usecase "考试提交" as S3
  usecase "成绩与预警查看" as S4
}
rectangle "教师端" {
  usecase "课程班级维护" as T1
  usecase "作业发布批改" as T2
  usecase "考试发布阅卷" as T3
  usecase "学情分析与 AI 辅助" as T4
}
rectangle "管理端" {
  usecase "账号角色维护" as A1
  usecase "基础字典维护" as A2
  usecase "服务运行配置" as A3
}
学生 --> S1
学生 --> S2
学生 --> S3
学生 --> S4
教师 --> T1
